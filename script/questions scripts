/* =============================================================================
   ANALYTICS PROJECT: JOB SALARY INSIGHTS
   PURPOSE: Analyze how experience, education, skills, and market factors
            influence salary across roles and industries.
============================================================================= */


-- ============================================================================
-- 1. How do education level and experience jointly impact salary by job title?
-- ============================================================================
WITH experience_bands AS (
    SELECT
        job_title,
        education_level,
        salary,
        CASE
            WHEN experience_years BETWEEN 0 AND 2 THEN 'Entry Level'
            WHEN experience_years BETWEEN 3 AND 5 THEN 'Junior Level'
            WHEN experience_years BETWEEN 6 AND 10 THEN 'Mid Level'
            ELSE 'Expert/Senior'
        END AS experience_category
    FROM job_salary_prediction
)

SELECT
    job_title,
    education_level,
    experience_category,
    ROUND(AVG(salary), 2) AS avg_salary
FROM experience_bands
GROUP BY job_title, education_level, experience_category
ORDER BY avg_salary DESC;


-- ============================================================================
-- 2. Which industry, company size, and location pay the most?
-- ============================================================================
SELECT
    industry,
    company_size,
    location,
    COUNT(*) AS total_jobs,
    ROUND(AVG(salary), 2) AS avg_salary
FROM job_salary_prediction
GROUP BY industry, company_size, location
ORDER BY avg_salary DESC;


-- ============================================================================
-- 3. Do remote, hybrid, or onsite roles pay differently by job title?
-- ============================================================================
SELECT
    job_title,
    ROUND(AVG(CASE WHEN remote_work = 'Remote' THEN salary END), 2) AS remote_avg,
    ROUND(AVG(CASE WHEN remote_work = 'Hybrid' THEN salary END), 2) AS hybrid_avg,
    ROUND(AVG(CASE WHEN remote_work = 'Onsite' THEN salary END), 2) AS onsite_avg
FROM job_salary_prediction
GROUP BY job_title
ORDER BY job_title;


-- ============================================================================
-- 4. Do skills and certifications impact salary across experience levels?
-- ============================================================================
WITH base AS (
    SELECT
        salary,
        CASE
            WHEN experience_years BETWEEN 0 AND 2 THEN 'Entry'
            WHEN experience_years BETWEEN 3 AND 5 THEN 'Junior'
            WHEN experience_years BETWEEN 6 AND 10 THEN 'Mid'
            ELSE 'Expert/Senior'
        END AS experience_level,
        CASE
            WHEN skills_count BETWEEN 0 AND 3 THEN 'Low'
            WHEN skills_count BETWEEN 4 AND 7 THEN 'Medium'
            ELSE 'High'
        END AS skill_level,
        CASE
            WHEN certifications = 0 THEN 'None'
            WHEN certifications BETWEEN 1 AND 2 THEN 'Basic'
            ELSE 'Advanced'
        END AS cert_level
    FROM job_salary_prediction
),

aggregated AS (
    SELECT
        experience_level,
        skill_level,
        cert_level,
        COUNT(*) AS total_employees,
        ROUND(AVG(salary), 2) AS avg_salary
    FROM base
    GROUP BY experience_level, skill_level, cert_level
)

SELECT *
FROM aggregated
ORDER BY experience_level, skill_level, cert_level;


-- ============================================================================
-- 5. Which job titles are most in demand and are they well compensated?
-- ============================================================================
WITH job_stats AS (
    SELECT
        job_title,
        industry,
        COUNT(*) AS demand_count,
        AVG(salary) AS avg_salary
    FROM job_salary_prediction
    GROUP BY job_title, industry
),

job_demand AS (
    SELECT
        job_title,
        SUM(demand_count) AS total_demand,
        COUNT(DISTINCT industry) AS industry_coverage,
        AVG(avg_salary) AS overall_avg_salary
    FROM job_stats
    GROUP BY job_title
),

market_baseline AS (
    SELECT AVG(salary) AS market_avg_salary
    FROM job_salary_prediction
)

SELECT
    jd.job_title,
    jd.total_demand,
    jd.industry_coverage,
    ROUND(jd.overall_avg_salary, 2) AS job_avg_salary,
    ROUND(mb.market_avg_salary, 2) AS market_avg_salary,
    CASE
        WHEN jd.overall_avg_salary > mb.market_avg_salary THEN 'Above Market'
        WHEN jd.overall_avg_salary < mb.market_avg_salary THEN 'Below Market'
        ELSE 'At Market'
    END AS compensation_status
FROM job_demand jd
CROSS JOIN market_baseline mb
ORDER BY jd.total_demand DESC, jd.industry_coverage DESC;

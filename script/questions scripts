/* =============================================================================
   ANALYTICS PROJECT: JOB SALARY INSIGHTS
   PURPOSE: Understand how experience, education, skills, and market factors
            influence salary across roles and industries.
============================================================================= */

-- ============================================================================
-- 1. How do education level and experience jointly impact salary by job title?
-- ============================================================================
WITH experience_bands AS (
    SELECT
        job_title,
        education_level,
        salary,
        CASE
            WHEN experience_years BETWEEN 0 AND 2 THEN 'Entry'
            WHEN experience_years BETWEEN 3 AND 5 THEN 'Junior'
            WHEN experience_years BETWEEN 6 AND 10 THEN 'Mid'
            ELSE 'Senior'
        END AS experience_level
    FROM job_salary_prediction
)

SELECT
    job_title,
    education_level,
    experience_level,
    ROUND(AVG(salary), 2) AS avg_salary
FROM experience_bands
GROUP BY job_title, education_level, experience_level
ORDER BY avg_salary DESC;


-- ============================================================================
-- 2. Which combination of industry, company size, and location pays the most?
-- ============================================================================
SELECT
    industry,
    company_size,
    location,
    COUNT(*) AS job_count,
    ROUND(AVG(CAST(salary AS DECIMAL(18,2))), 2) AS avg_salary
FROM job_salary_prediction
GROUP BY industry, company_size, location
ORDER BY avg_salary DESC;


-- ============================================================================
-- 3. Do remote, hybrid, or onsite employees earn more by job title?
-- ============================================================================
SELECT
    job_title,
    ROUND(AVG(CASE WHEN remote_work = 'Remote' THEN salary END), 2) AS remote_avg,
    ROUND(AVG(CASE WHEN remote_work = 'Hybrid' THEN salary END), 2) AS hybrid_avg,
    ROUND(AVG(CASE WHEN remote_work = 'Onsite' THEN salary END), 2) AS onsite_avg
FROM job_salary_prediction
GROUP BY job_title
ORDER BY job_title;


-- ============================================================================
-- 4. Do skills and certifications impact salary across experience levels?
-- ============================================================================
WITH base AS (
    SELECT
        salary,
        CASE
            WHEN experience_years BETWEEN 0 AND 2 THEN 'Entry'
            WHEN experience_years BETWEEN 3 AND 5 THEN 'Junior'
            WHEN experience_years BETWEEN 6 AND 10 THEN 'Mid'
            ELSE 'Senior'
        END AS experience_level,
        CASE
            WHEN skills_count <= 3 THEN 'Low'
            WHEN skills_count <= 7 THEN 'Medium'
            ELSE 'High'
        END AS skill_level,
        CASE
            WHEN certifications = 0 THEN 'None'
            WHEN certifications <= 2 THEN 'Basic'
            ELSE 'Advanced'
        END AS cert_level
    FROM job_salary_prediction
)

SELECT
    experience_level,
    skill_level,
    cert_level,
    COUNT(*) AS employee_count,
    ROUND(AVG(salary), 2) AS avg_salary
FROM base
GROUP BY experience_level, skill_level, cert_level
ORDER BY experience_level, skill_level, cert_level;


-- ============================================================================
-- 5. Which job titles are most in demand and are they well compensated?
-- ============================================================================
WITH job_stats AS (
    SELECT
        job_title,
        industry,
        COUNT(*) AS demand,
        AVG(salary) AS avg_salary
    FROM job_salary_prediction
    GROUP BY job_title, industry
),
job_aggregated AS (
    SELECT
        job_title,
        SUM(demand) AS total_demand,
        COUNT(DISTINCT industry) AS industry_coverage,
        AVG(avg_salary) AS avg_job_salary
    FROM job_stats
    GROUP BY job_title
),
market AS (
    SELECT AVG(salary) AS market_avg
    FROM job_salary_prediction
)

SELECT
    j.job_title,
    j.total_demand,
    j.industry_coverage,
    ROUND(j.avg_job_salary, 2) AS job_avg_salary,
    ROUND(m.market_avg, 2) AS market_avg_salary,
    CASE
        WHEN j.avg_job_salary > m.market_avg THEN 'Above Market'
        WHEN j.avg_job_salary < m.market_avg THEN 'Below Market'
        ELSE 'At Market'
    END AS compensation_status
FROM job_aggregated j
CROSS JOIN market m
ORDER BY j.total_demand DESC, j.industry_coverage DESC;
